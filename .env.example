# SEC requires a descriptive User-Agent identifying the requester on every API request.
# Format: "Your Name your.email@example.com" -- requests without one get rejected.
SEC_USER_AGENT="Your Name your.email@example.com"

# Optional: local dir to cache raw XBRL API responses during dev, to avoid re-hitting
# SEC's rate limit while iterating.
XBRL_CACHE_DIR=data/raw/xbrl_cache

# Path B retrieval stack: semantic (sentence-transformers bi-encoder +
# cross-encoder reranker) or lexical (TF-IDF + term overlap, no model download).
# Default is semantic. Retrieval labels are only valid for the stack that
# produced them, so changing this invalidates an existing review queue.
RETRIEVAL_PROFILE=semantic
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Alerts. Optional: with none of these set the pipeline polls normally and
# sends nothing. Slack takes precedence if both are configured. Only filings
# with at least one NOTABLE finding are delivered.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# NOTIFY_EMAIL_FROM=copilot@example.com
# NOTIFY_EMAIL_TO=you@example.com, someone@example.com
